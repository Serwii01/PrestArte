# Copia este fichero a .env y rellena los valores. El .env NUNCA se sube a git.

# URL pública de la aplicación (enlaces de los emails y CORS)
PUBLIC_URL=http://localhost
APP_PORT=80

# Base de datos
DB_USERNAME=prestarte
DB_PASSWORD=cambia-esto
DB_ROOT_PASSWORD=cambia-esto-tambien

# Correo saliente (Gmail con contraseña de aplicación, u otro SMTP)
MAIL_USERNAME=tu-cuenta@gmail.com
MAIL_PASSWORD=contraseña-de-aplicacion

# Secreto de los tokens JWT (genéralo con: openssl rand -base64 64)
JWT_SECRET=

# Administrador inicial (se crea al primer arranque)
ADMIN_EMAIL=admin@tu-dominio.es
ADMIN_PASSWORD=una-contraseña-larga-y-única

# true una sola vez para mover a disco los archivos antiguos guardados en MySQL
APP_STORAGE_MIGRATE_LEGACY=false
# Geocodificación de ciudades con OpenStreetMap (Nominatim)
APP_GEOCODING_ENABLED=true
